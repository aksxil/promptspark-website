{
  "name": "promptspark-website",
  "version": "1.0.0",
  "private": true,
  "description": "Official website for PromptSpark, the Android AI prompt library app.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-app-ads.mjs",
    "build": "next build",
    "postbuild": "node scripts/fix-rsc-paths.mjs",
    "start": "npx --yes serve@14.2.4 out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-links.mjs",
    "check:facts": "node scripts/check-facts.mjs",
    "qa": "npm run typecheck && npm run lint && npm run build && npm run check:links"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
